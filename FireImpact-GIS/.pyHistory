aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps("Scene1")[0] l = m.listLayers("dNBR_True_Fire_Only.tif")[0] l.transparency = 40
l.transparency = 20
aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps("Scene1")[0]  # Haritanin arka plan ayarlarina (CIM) erisim cim = m.getDefinition("V3")  # Sisi ve beyazlasmayi tamamen kapat cim.illumination.displayAtmosphere = False  # Ayarlari haritaya uygula m.setDefinition(cim)
import arcpy  aprx = arcpy.mp.ArcGISProject("CURRENT") m = aprx.listMaps("Map")[0]  # 2D Map sekmesi  # 1. Future_Fire_Risk_V4.tif saydamligini %30 yap risk_layer = m.listLayers("Future_Fire_Risk_V4.tif")[0] risk_layer.transparency = 30  # 2. main_fire_perimeter dis cizgi kalinligini 1pt yap perimeter_layer = m.listLayers("main_fire_perimeter")[0] sym = perimeter_layer.symbology sym.renderer.symbol.outlineWidth = 1 perimeter_layer.symbology = sym  print("Tamamlandi! Haritayi kontrol et.")
