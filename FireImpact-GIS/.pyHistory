import sys sys.path.append(r"C:\Users\PC\.gemini\antigravity-ide\brain\55ade938-5ad7-4095-a1eb-26368b356086\scratch") import arcpy_scientific_analysis
import arcpy from arcpy.sa import *  # Eski çıktıların üzerine yazmaya izin ver arcpy.env.overwriteOutput = True arcpy.CheckOutExtension("Spatial")  # Dosya yolları in_raster = r"C:\Users\PC\Desktop\projeler\FireImpact-GIS\data\Sentinel2_Raw\dNBR_Scientific.tif" out_path = r"C:\Users\PC\Desktop\projeler\FireImpact-GIS\data\Sentinel2_Raw\dNBR_Classified.tif"  print("?? Bilimsel Sınıflandırma yapılıyor, lütfen bekleyin...")  # USGS Sınıflandırma Değerleri (Alt Sınır, Üst Sınır, Yeni Kategori Numarası) # Kategori 1: Yanmayan (Yeşil/Şeffaf) # Kategori 2: Düşük Şiddet (Sarı) # Kategori 3: Orta Düşük Şiddet (Turuncu) # Kategori 4: Orta Yüksek Şiddet (Kırmızı) # Kategori 5: Yüksek Şiddet (Koyu Kırmızı/Siyah) remap = RemapRange([     [-5.0, 0.1, 1],        [0.1, 0.27, 2],        [0.27, 0.44, 3],       [0.44, 0.66, 4],       [0.66, 5.0, 5]     ])  # Reclassify İşlemi out_reclass = Reclassify(in_raster, "Value", remap) out_reclass.save(out_path)  print("? Başarılı! Yeni ve kusursuz sınıflandırılmış dosyanız oluşturuldu: dNBR_Classified.tif")
import arcpy from arcpy.sa import * import os  print("?? Adım 2: Su Maskeleme ve Sınıflandırma Başlıyor ??")  # Çalışma klasörümüz (Dosyaların indiği yer) workspace = r"C:\Users\PC\Desktop\projeler\FireImpact-GIS\data\Sentinel2_Raw" arcpy.env.workspace = workspace arcpy.env.overwriteOutput = True arcpy.CheckOutExtension("Spatial")  pre_b8 = os.path.join(workspace, "pre_fire_B08.tif") pre_b12 = os.path.join(workspace, "pre_fire_B12.tif") post_b8 = os.path.join(workspace, "post_fire_B08.tif") post_b12 = os.path.join(workspace, "post_fire_B12.tif") pre_scl = os.path.join(workspace, "pre_fire_SCL.tif") post_scl = os.path.join(workspace, "post_fire_SCL.tif")  print("1. Rasterlar ve SCL (Yapay Zeka Sınıflandırma) katmanları yükleniyor...") # SCL (20m) ile B08 (10m) çözünürlüğünü eşitlemek için ArcPy ortamını 10m'ye kilitliyoruz. arcpy.env.cellSize = pre_b8 arcpy.env.snapRaster = pre_b8  # Dosyaları Raster objelerine çevirelim r_pre_b8 = Raster(pre_b8) r_pre_b12 = Raster(pre_b12) r_post_b8 = Raster(post_b8) r_post_b12 = Raster(post_b12) r_pre_scl = Raster(pre_scl) r_post_scl = Raster(post_scl)  print("2. Maskeleme Kuralları Uygulanıyor (Su, Bulut, Gölge haritadan siliniyor)...") # Bilimsel Not: Sentinel-2'de Su=6, Bulut Gölgesi=3, Bulutlar=8,9,10, Kar=11 def get_valid_mask(scl_raster):     # Eğer piksel su, bulut veya gölge ise 0 yap (geçersiz), değilse 1 yap (geçerli)     return Con((scl_raster == 6) | (scl_raster == 3) | (scl_raster == 8) | (scl_raster == 9) | (scl_raster == 10) | (scl_raster == 11), 0, 1)  pre_valid = get_valid_mask(r_pre_scl) post_valid = get_valid_mask(r_post_scl) # Hem yangın öncesi hem sonrası GÜVENİLİR olan pikselleri buluyoruz final_valid_mask = pre_valid & post_valid  print("3. dNBR Hesaplanıyor...") pre_nbr = (Float(r_pre_b8) - Float(r_pre_b12)) / (Float(r_pre_b8) + Float(r_pre_b12)) post_nbr = (Float(r_post_b8) - Float(r_post_b12)) / (Float(r_post_b8) + Float(r_post_b12)) dnbr = pre_nbr - post_nbr  print("4. Su Maskesi dNBR üzerine uygulanıyor...") # SetNull: Eğer maske geçersizse (0), o pikseli Null (boş) yap. Değilse dNBR değerini koru. dnbr_masked = SetNull(final_valid_mask == 0, dnbr)  print("5. Sınıflandırma (USGS Burn Severity) Yapılıyor...") remap = RemapRange([     [-5.0, 0.1, 1],   # Yanmayan (Yeşil / Şeffaf olacak)     [0.1, 0.27, 2],   # Düşük Şiddet     [0.27, 0.44, 3],  # Orta Düşük     [0.44, 0.66, 4],  # Orta Yüksek     [0.66, 5.0, 5]    # Yüksek Şiddet ]) out_reclass = Reclassify(dnbr_masked, "Value", remap)  # Sonucu kaydedelim out_file = os.path.join(workspace, "dNBR_Masked_Classified.tif") out_reclass.save(out_file)  print(f"? İşlem tamam! Maskelenmiş dosya: {out_file}") print("Bu yeni dosyayı (dNBR_Masked_Classified.tif) Catalog menüsünden haritaya sürükleyin.") print("Eski yaptığınız gibi 1 numaralı sınıfı 'No Color' yaparsanız, GÖLLERİN KAYBOLDUĞUNU göreceksiniz!")
import arcpy import os  workspace = r"C:\Users\PC\Desktop\projeler\FireImpact-GIS\data\Sentinel2_Raw" arcpy.env.workspace = workspace tif_file = os.path.join(workspace, "dNBR_Masked_Classified.tif")  # 1. Renk Haritası (Colormap - CLR) dosyasını kodla yaratıyoruz # Format: Değer Kırmızı Yeşil Mavi clr_file = os.path.join(workspace, "burn_colors.clr") with open(clr_file, "w") as f:     f.write("1 255 255 255\n")  # 1: Yanmayan (Beyaz)     f.write("2 255 255 0\n")    # 2: Düşük Şiddet (Sarı)     f.write("3 255 170 0\n")    # 3: Orta Şiddet (Turuncu)     f.write("4 255 0 0\n")      # 4: Yüksek Şiddet (Kırmızı)     f.write("5 115 0 0\n")      # 5: Çok Yüksek Şiddet (Bordo)  print("1. Renkler (Colormap) kalıcı olarak TIF dosyasına gömülüyor...") # Bu kod, renkleri TIF dosyasının içine kalıcı yazar! Başka bilgisayarda bile böyle açılır. arcpy.management.AddColormap(tif_file, input_CLR_file=clr_file)  print("2. Haritaya ekleniyor...") aprx = arcpy.mp.ArcGISProject("CURRENT") map_obj = aprx.listMaps()[0] map_obj.addDataFromPath(tif_file)  print("? BİTTİ! Ekranda renkli haritayı görebilirsiniz.")
import arcpy from arcpy.sa import * import os  print("?? Adım 4: Tüm Yangın Alanı Birleştiriliyor (Mosaic) ve Sınıflandırılıyor ??")  workspace = r"C:\Users\PC\Desktop\projeler\FireImpact-GIS\data\Sentinel2_Raw" arcpy.env.workspace = workspace arcpy.env.overwriteOutput = True arcpy.CheckOutExtension("Spatial")  print("1. Kuzey (T36SUG) ve Güney (T36SUF) kareleri birleştiriliyor (Mosaic)...")  def mosaic_rasters(raster_list, out_name):     print(f"Birleştiriliyor: {out_name}...")     arcpy.management.MosaicToNewRaster(         input_rasters=raster_list,         output_location=workspace,         raster_dataset_name_with_extension=out_name,         pixel_type="16_BIT_UNSIGNED",         number_of_bands=1,         mosaic_method="LAST"     )     return os.path.join(workspace, out_name)  # B08 and B12 Pre pre_b8_mosaic = mosaic_rasters(["pre_fire_B08.tif", "pre_fire_south_B08.tif"], "pre_b8_mosaic.tif") pre_b12_mosaic = mosaic_rasters(["pre_fire_B12.tif", "pre_fire_south_B12.tif"], "pre_b12_mosaic.tif") pre_scl_mosaic = mosaic_rasters(["pre_fire_SCL.tif", "pre_fire_south_SCL.tif"], "pre_scl_mosaic.tif")  # B08 and B12 Post post_b8_mosaic = mosaic_rasters(["post_fire_B08.tif", "post_fire_south_B08.tif"], "post_b8_mosaic.tif") post_b12_mosaic = mosaic_rasters(["post_fire_B12.tif", "post_fire_south_B12.tif"], "post_b12_mosaic.tif") post_scl_mosaic = mosaic_rasters(["post_fire_SCL.tif", "post_fire_south_SCL.tif"], "post_scl_mosaic.tif")  print("2. Devasa haritalar (200km x 100km) yükleniyor...") arcpy.env.cellSize = pre_b8_mosaic arcpy.env.snapRaster = pre_b8_mosaic  r_pre_b8 = Raster(pre_b8_mosaic) r_pre_b12 = Raster(pre_b12_mosaic) r_post_b8 = Raster(post_b8_mosaic) r_post_b12 = Raster(post_b12_mosaic) r_pre_scl = Raster(pre_scl_mosaic) r_post_scl = Raster(post_scl_mosaic)  print("3. Maskeleme Kuralları Uygulanıyor (Su, Bulut, Gölge siliniyor)...") def get_valid_mask(scl_raster):     return Con((scl_raster == 6) | (scl_raster == 3) | (scl_raster == 8) | (scl_raster == 9) | (scl_raster == 10) | (scl_raster == 11), 0, 1)  pre_valid = get_valid_mask(r_pre_scl) post_valid = get_valid_mask(r_post_scl) final_valid_mask = pre_valid & post_valid  print("4. dNBR Hesaplanıyor...") pre_nbr = (Float(r_pre_b8) - Float(r_pre_b12)) / (Float(r_pre_b8) + Float(r_pre_b12)) post_nbr = (Float(r_post_b8) - Float(r_post_b12)) / (Float(r_post_b8) + Float(r_post_b12)) dnbr = pre_nbr - post_nbr dnbr_masked = SetNull(final_valid_mask == 0, dnbr)  print("5. Sınıflandırma (USGS Burn Severity) Yapılıyor...") remap = RemapRange([     [-5.0, 0.1, 1],        [0.1, 0.27, 2],        [0.27, 0.44, 3],       [0.44, 0.66, 4],       [0.66, 5.0, 5]     ]) out_reclass = Reclassify(dnbr_masked, "Value", remap) out_file = os.path.join(workspace, "dNBR_Full_Masked_Classified.tif")  print("Sonuç kaydediliyor (Bu işlem devasa boyut nedeniyle biraz uzun sürebilir)...") out_reclass.save(out_file)  # Lock hatası almamak için değişkenleri siliyoruz del out_reclass del dnbr_masked del final_valid_mask  print("6. Renklendirme dosyası oluşturuluyor...") clr_file = os.path.join(workspace, "burn_colors.clr") with open(clr_file, "w") as f:     f.write("1 255 255 255\n") # Beyaz     f.write("2 255 255 0\n")   # Sarı     f.write("3 255 170 0\n")   # Turuncu     f.write("4 255 0 0\n")     # Kırmızı     f.write("5 115 0 0\n")     # Bordo  print("7. Haritaya ekleniyor...") try:     arcpy.management.AddColormap(out_file, input_CLR_file=clr_file)     aprx = arcpy.mp.ArcGISProject("CURRENT")     map_obj = aprx.listMaps()[0]     map_obj.addDataFromPath(out_file) except Exception as e:     print(f"Uyarı: Python renklendirme otomatik eklenemedi, manuel yapabilirsiniz. Hata: {e}")  print(f"? BÜTÜN İŞLEMLER TAMAMLANDI! {out_file}")
